# --- Phase 1 (required) ---
DATABASE_URL=postgresql://insight:insight@127.0.0.1:5432/insight_ai
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Phase 2 (required) ---
# Data engine (Python). Must match ENGINE_API_KEY given to the engine container.
FASTAPI_URL=http://127.0.0.1:8000
ENGINE_API_KEY=dev-engine-key-change-me

# --- Phase 3 (required for the AI Analyst) ---
OPENAI_API_KEY=
# Any OpenAI chat model that supports structured outputs. Check current model names
# and prices at platform.openai.com and update the two price lines to match.
OPENAI_MODEL=gpt-4.1-mini
OPENAI_PRICE_INPUT_PER_1M=0.40
OPENAI_PRICE_OUTPUT_PER_1M=1.60
# Optional: a compatible API endpoint (used by the end-to-end tests' stand-in model).
# OPENAI_BASE_URL=

# --- Phase 6 (required for the Knowledge base) ---
# Create a serverless index in the Pinecone console: dimension 1536, metric cosine
# (matches text-embedding-3-small). Put its name here.
PINECONE_API_KEY=
PINECONE_INDEX=insightai
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Minimum similarity for a passage to be given to the AI (0-1). Raise it if answers cite
# loosely related passages; lower it if relevant passages are missed.
RAG_MIN_SCORE=0.3
# Optional: PINECONE_HOST (skip the index lookup), PINECONE_API_VERSION (default 2025-01)

# --- Phase 8 (scheduled workflows) ---
# Shared secret for the scheduler; must match the "scheduler" service in docker-compose.
CRON_SECRET=dev-cron-secret-change-me

# --- Later phases (not used yet) ---
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
